{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.dusty_dusty.cts_compats.fabric.CTSCompatsFabric"
    ],
    "client": [
      "net.dusty_dusty.cts_compats.fabric.CTSCompatsFabricClient"
    ]
  },
  "mixins": [
    "cts_compats-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "architectury": ">=${architectury_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=17",
    "terrain_slabs": ">=4.0.3-beta"
  }
}
